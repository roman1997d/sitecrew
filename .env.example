PORT=3000
# Local dev
PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3000
ADMIN_HOST=localhost
API_BASE_URL=http://localhost:4000
API_INTERNAL_URL=http://127.0.0.1:4000

# Production (behind nginx)
# PUBLIC_URL=https://sitecrew.uk
# ADMIN_PUBLIC_URL=https://admin.sitecrew.uk
# ADMIN_HOST=admin.sitecrew.uk
# API_BASE_URL=https://sitecrew.uk
# API_INTERNAL_URL=http://127.0.0.1:4000

# Public contact email shown on /contact
CONTACT_EMAIL=info@sitecrew.uk

# Admin-only fake data simulator (disable before real traffic — see backend/src/modules/admin/fakeDataSimulator/)
ENABLE_FAKE_DATA_SIMULATOR=false
# FAKE_SIMULATOR_PASSWORD=SimFpd2026!

RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=your-v2-secret-key

# Google Search Console site verification (HTML meta tag value)
# GOOGLE_SITE_VERIFICATION=your-verification-code

# Google Analytics measurement ID
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
