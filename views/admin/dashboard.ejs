<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel | SiteCrew</title>
  <%- include('../partials/favicon') %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body class="admin-body">
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <div class="admin-sidebar-brand">
        <i class="bi bi-shield-lock"></i>
        <div>
          <strong>SiteCrew</strong>
          <span>Admin Panel</span>
        </div>
      </div>

      <nav class="admin-nav" aria-label="Admin sections">
        <button type="button" class="active" data-admin-section="metrics" title="Metrics Tracker"><i class="bi bi-speedometer2"></i> Metrics</button>
        <button type="button" data-admin-section="users" title="Users"><i class="bi bi-people"></i> Users</button>
        <button type="button" data-admin-section="companies" title="Company Accounts"><i class="bi bi-building"></i> Companies</button>
        <button type="button" data-admin-section="market" title="Market and Money"><i class="bi bi-currency-pound"></i> Market</button>
        <button type="button" data-admin-section="posts" title="Posts Moderator"><i class="bi bi-card-text"></i> Posts</button>
        <button type="button" data-admin-section="blog" title="Blog Manager"><i class="bi bi-newspaper"></i> Blog</button>
        <button type="button" data-admin-section="fake-simulator" title="Demo data generator"><i class="bi bi-magic"></i> Demo data</button>
        <button type="button" data-admin-section="api-logs" title="API Logs"><i class="bi bi-terminal"></i> API Logs</button>
        <button type="button" data-admin-section="audit" title="Audit Trails"><i class="bi bi-journal-text"></i> Audit</button>
        <button type="button" data-admin-section="server" title="Server"><i class="bi bi-hdd-network"></i> Server</button>
        <button type="button" data-admin-section="email-control" title="Email Control"><i class="bi bi-envelope"></i> Email Control</button>
      </nav>

      <div class="admin-sidebar-footer">
        <p id="adminUserEmail">Loading...</p>
        <button type="button" id="adminLogoutBtn"><i class="bi bi-box-arrow-right"></i> Log out</button>
      </div>
    </aside>

    <main class="admin-main">
      <header class="admin-topbar">
        <div>
          <p>Platform administration</p>
          <h1 id="adminSectionTitle">Metrics Tracker</h1>
        </div>
        <div class="admin-topbar-actions">
          <button type="button" class="admin-secondary-btn admin-demo-data-btn" id="adminOpenFakeSimulatorBtn" title="Open demo data generator">
            <i class="bi bi-magic"></i> Demo data
          </button>
          <button type="button" class="admin-refresh-btn" id="adminRefreshBtn"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
        </div>
      </header>

      <section class="admin-section active" id="adminSection-metrics" data-section="metrics">
        <p class="admin-section-lead">Track your application performance across users, companies, jobs, and API traffic.</p>
        <div class="admin-metrics-grid" id="adminMetricsGrid">
          <p class="admin-empty">Loading metrics...</p>
        </div>
      </section>

      <section class="admin-section" id="adminSection-users" data-section="users" hidden>
        <p class="admin-section-lead">Click a user row to view and edit profile details. Accounts marked as <strong>deleted</strong> are permanently removed after 24 hours.</p>

        <div class="admin-users-panel">
          <div class="admin-toolbar" id="adminUsersToolbar">
            <label class="admin-search-field">
              <i class="bi bi-search" aria-hidden="true"></i>
              <input type="search" id="adminUsersSearch" placeholder="Search by name, email or ID" autocomplete="off">
            </label>

            <label class="admin-toolbar-field">
              <span>Role</span>
              <select id="adminUsersRoleFilter" aria-label="Filter by role">
                <option value="">All roles</option>
                <option value="worker">Worker</option>
                <option value="company">Company</option>
                <option value="admin">Admin</option>
                <option value="superadmin">Superadmin</option>
              </select>
            </label>

            <label class="admin-toolbar-field">
              <span>Status</span>
              <select id="adminUsersStatusFilter" aria-label="Filter by status">
                <option value="">All statuses</option>
                <option value="active">Active</option>
                <option value="paused">Paused</option>
                <option value="suspended">Suspended</option>
                <option value="deleted">Deleted</option>
              </select>
            </label>

            <label class="admin-toolbar-field">
              <span>Rating</span>
              <select id="adminUsersRatingFilter" aria-label="Filter by rating">
                <option value="">All ratings</option>
                <option value="none">No rating</option>
                <option value="5">5 stars</option>
                <option value="4">4+ stars</option>
                <option value="3">3+ stars</option>
                <option value="2">2+ stars</option>
                <option value="1">1+ stars</option>
              </select>
            </label>

            <label class="admin-toolbar-field">
              <span>Sort by</span>
              <select id="adminUsersSort" aria-label="Sort users">
                <option value="created_desc">Newest first</option>
                <option value="created_asc">Oldest first</option>
                <option value="name_asc">Name A–Z</option>
                <option value="name_desc">Name Z–A</option>
                <option value="email_asc">Email A–Z</option>
                <option value="email_desc">Email Z–A</option>
                <option value="role_asc">Role A–Z</option>
                <option value="status_asc">Status A–Z</option>
              </select>
            </label>

            <button type="button" class="admin-secondary-btn" id="adminUsersClearBtn">Clear filters</button>
          </div>

          <p class="admin-results-meta" id="adminUsersResultsMeta">Loading users...</p>

          <div class="admin-table-wrap" id="adminUsersTable">
            <p class="admin-empty">Loading users...</p>
          </div>
        </div>
      </section>

      <section class="admin-section" id="adminSection-companies" data-section="companies" hidden>
        <p class="admin-section-lead">Manage company accounts, subscriptions, verification, and billing actions. Click a row to open full details.</p>
        <div class="admin-users-panel">
          <div class="admin-toolbar" id="adminCompaniesToolbar">
            <label class="admin-search-field">
              <i class="bi bi-search" aria-hidden="true"></i>
              <input type="search" id="adminCompaniesSearch" placeholder="Search by company, email, city or ID" autocomplete="off">
            </label>

            <label class="admin-toolbar-field">
              <span>Plan</span>
              <select id="adminCompaniesPlanFilter" aria-label="Filter by plan">
                <option value="">All plans</option>
                <option value="free">Free</option>
                <option value="pro">Pro</option>
                <option value="ultra">Ultra</option>
              </select>
            </label>

            <label class="admin-toolbar-field">
              <span>Verification</span>
              <select id="adminCompaniesVerificationFilter" aria-label="Filter by verification">
                <option value="">All verification</option>
                <option value="pending">Pending</option>
                <option value="approved">Approved</option>
                <option value="rejected">Rejected</option>
              </select>
            </label>

            <label class="admin-toolbar-field">
              <span>User status</span>
              <select id="adminCompaniesStatusFilter" aria-label="Filter by user status">
                <option value="">All statuses</option>
                <option value="active">Active</option>
                <option value="paused">Paused</option>
                <option value="suspended">Suspended</option>
                <option value="deleted">Deleted</option>
              </select>
            </label>

            <label class="admin-toolbar-field">
              <span>Rating</span>
              <select id="adminCompaniesRatingFilter" aria-label="Filter by rating">
                <option value="">All ratings</option>
                <option value="none">No rating</option>
                <option value="5">5 stars</option>
                <option value="4">4+ stars</option>
                <option value="3">3+ stars</option>
                <option value="2">2+ stars</option>
                <option value="1">1+ stars</option>
              </select>
            </label>

            <label class="admin-toolbar-field">
              <span>Sort by</span>
              <select id="adminCompaniesSort" aria-label="Sort companies">
                <option value="created_desc">Newest first</option>
                <option value="created_asc">Oldest first</option>
                <option value="name_asc">Company A–Z</option>
                <option value="name_desc">Company Z–A</option>
                <option value="email_asc">Email A–Z</option>
                <option value="email_desc">Email Z–A</option>
                <option value="verification_asc">Verification A–Z</option>
                <option value="status_asc">User status A–Z</option>
              </select>
            </label>

            <button type="button" class="admin-secondary-btn" id="adminCompaniesExpiringBtn" aria-pressed="false">
              Expiring soon only
            </button>

            <button type="button" class="admin-secondary-btn" id="adminCompaniesClearBtn">Clear filters</button>
          </div>

          <p class="admin-results-meta" id="adminCompaniesResultsMeta">Loading companies...</p>

          <div class="admin-table-wrap" id="adminCompaniesTable">
            <p class="admin-empty">Loading companies...</p>
          </div>
        </div>
      </section>

      <section class="admin-section" id="adminSection-market" data-section="market" hidden>
        <p class="admin-section-lead">Manage company access plans, sales terms, and paid marketplace ads for the worker feed.</p>
        <div class="admin-market-panel">
          <div class="admin-market-subnav" role="tablist" aria-label="Market panels">
            <button type="button" class="active" data-market-panel="plans" role="tab" aria-selected="true">Plans</button>
            <button type="button" data-market-panel="ads" role="tab" aria-selected="false">Ads</button>
          </div>

          <div class="admin-market-panel-view active" id="adminMarketPlansPanel" data-market-panel="plans" role="tabpanel">
            <div class="admin-market-toolbar">
              <p class="admin-results-meta" id="adminMarketMeta">Loading access plans...</p>
              <button type="button" class="admin-secondary-btn" id="adminSalesTermsBtn">
                <i class="bi bi-file-earmark-text"></i> Sales plan T&amp;C
              </button>
            </div>
            <div class="admin-market-grid" id="adminMarketPlansGrid">
              <p class="admin-empty">Loading access plans...</p>
            </div>
          </div>

          <div class="admin-market-panel-view" id="adminMarketAdsPanel" data-market-panel="ads" role="tabpanel" hidden>
            <div id="adminMarketAdsListView">
              <div class="admin-market-ads-toolbar">
                <p class="admin-results-meta" id="adminMarketAdsMeta">Manage sponsored feed posts for workers.</p>
                <button type="button" class="admin-primary-btn" id="adminMarketAdsCreateBtn">
                  <i class="bi bi-plus-lg"></i> Create ad post
                </button>
              </div>
              <div class="admin-table-wrap" id="adminMarketAdsTable">
                <p class="admin-empty">No marketplace ads yet.</p>
              </div>
            </div>

            <div id="adminMarketAdsEditorView" hidden>
              <div class="admin-market-ads-editor-header">
                <button type="button" class="admin-secondary-btn" id="adminMarketAdsBackBtn">
                  <i class="bi bi-arrow-left"></i> Back to ads
                </button>
                <p class="admin-results-meta" id="adminMarketAdsEditorMeta">Create ad post</p>
              </div>
              <div class="admin-market-ads-editor-layout">
                <form id="adminMarketAdForm" class="admin-market-ad-form">
                  <fieldset class="admin-market-ad-section">
                    <legend>Ad post</legend>
                    <label class="admin-field">
                      <span>Internal title</span>
                      <input type="text" id="adminMarketAdInternalTitle" maxlength="120" placeholder="Screwfix — hand tools promo" required>
                    </label>
                    <div class="admin-market-ad-grid-2">
                      <label class="admin-field">
                        <span>Start date</span>
                        <input type="date" id="adminMarketAdStartsAt" required>
                      </label>
                      <label class="admin-field">
                        <span>End date</span>
                        <input type="date" id="adminMarketAdEndsAt" required>
                      </label>
                    </div>
                    <label class="admin-field admin-market-toggle-field">
                      <input type="checkbox" id="adminMarketAdAllowOnTop">
                      <span>Allow on top (pinned above feed)</span>
                    </label>
                    <div class="admin-field">
                      <span>Target trades</span>
                      <input type="search" id="adminMarketAdTradeSearch" placeholder="Search trades (min 3 letters)" autocomplete="off">
                      <div class="admin-market-trade-results" id="adminMarketAdTradeResults" hidden></div>
                      <div class="admin-market-trade-chips" id="adminMarketAdTradeChips"></div>
                    </div>
                  </fieldset>

                  <fieldset class="admin-market-ad-section">
                    <div class="admin-market-ad-section-head">
                      <legend>Products (max 3)</legend>
                      <button type="button" class="admin-secondary-btn" id="adminMarketAdAddProductBtn">Add product</button>
                    </div>
                    <div id="adminMarketAdProductsList" class="admin-market-ad-products-list"></div>
                  </fieldset>

                  <fieldset class="admin-market-ad-section">
                    <legend>Ad info</legend>
                    <label class="admin-field">
                      <span>Client name</span>
                      <input type="text" id="adminMarketAdClientName" maxlength="160" placeholder="Screwfix Ltd" required>
                    </label>
                    <label class="admin-field">
                      <span>Address</span>
                      <input type="text" id="adminMarketAdClientAddress" maxlength="300" placeholder="Trade counter address">
                    </label>
                    <label class="admin-field">
                      <span>Activity scope</span>
                      <textarea id="adminMarketAdActivityScope" rows="3" maxlength="500" placeholder="Electrical supplies, hand tools, fixings"></textarea>
                    </label>
                    <label class="admin-field admin-market-toggle-field">
                      <input type="checkbox" id="adminMarketAdIsPaid" checked>
                      <span>Is this ad paid</span>
                    </label>
                  </fieldset>

                  <div class="admin-market-ad-form-actions">
                    <button type="button" class="admin-secondary-btn" id="adminMarketAdSaveDraftBtn">Save draft</button>
                    <button type="submit" class="admin-primary-btn" id="adminMarketAdPublishBtn">Publish ad</button>
                  </div>
                </form>

                <aside class="admin-market-ad-preview-panel">
                  <p class="admin-market-ad-preview-label">Worker feed preview</p>
                  <div id="adminMarketAdPreview" class="admin-market-ad-preview"></div>
                </aside>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="admin-section" id="adminSection-posts" data-section="posts" hidden>
        <div class="admin-posts-moderator">
          <p class="admin-posts-status" id="adminPostsModerationStatus">Checking moderation services...</p>

          <div class="admin-posts-subnav" role="tablist" aria-label="Posts moderator panels">
            <button type="button" class="active" data-posts-panel="list" role="tab" aria-selected="true">Posts list</button>
            <button type="button" data-posts-panel="share-previews" role="tab" aria-selected="false">Share previews</button>
            <button type="button" data-posts-panel="ai-scan" role="tab" aria-selected="false">AI Scan</button>
            <button type="button" data-posts-panel="media-review" role="tab" aria-selected="false">Media Review</button>
          </div>

          <div class="admin-posts-panel active" id="adminPostsListPanel" data-posts-panel="list" role="tabpanel">
            <div class="admin-table-wrap" id="adminPostsTable">
              <p class="admin-empty">Loading posts...</p>
            </div>
          </div>

          <div class="admin-posts-panel" id="adminPostsSharePreviewsPanel" data-posts-panel="share-previews" role="tabpanel" hidden>
            <div class="admin-share-previews">
              <p class="admin-section-lead">
                Upload images used when sharing <strong>jobs</strong> and <strong>blog articles</strong> on social media.
                Recommended size: <strong>1200×630 px</strong>. Uploaded images appear as presets in company job posts and blog editor.
              </p>

              <form id="adminSharePreviewUploadForm" class="admin-share-preview-upload">
                <label class="admin-field">
                  <span>Upload preview image</span>
                  <input type="file" id="adminSharePreviewFile" accept="image/jpeg,image/png,image/webp,image/gif" required>
                </label>
                <button type="submit" class="admin-primary-btn" id="adminSharePreviewUploadBtn">
                  <i class="bi bi-cloud-upload"></i> Upload preset
                </button>
              </form>

              <p class="admin-results-meta" id="adminSharePreviewsMeta">Loading preview images...</p>
              <div class="admin-share-previews-grid" id="adminSharePreviewsGrid">
                <p class="admin-empty">Loading preview images...</p>
              </div>
            </div>
          </div>

          <div class="admin-posts-panel" id="adminPostsAiScanPanel" data-posts-panel="ai-scan" role="tabpanel" hidden>
            <div class="admin-text-review">
              <div class="admin-text-review-toolbar">
                <button type="button" class="admin-secondary-btn" id="adminTextReviewRiskOnlyBtn" aria-pressed="false">
                  Show only Risk Posts
                </button>
                <button type="button" class="admin-secondary-btn" id="adminTextReviewLearnModeBtn" aria-pressed="false">
                  Learn mode: OFF
                </button>
                <button type="button" class="admin-secondary-btn" id="adminTextReviewRescanBtn">
                  Rescan all posts
                </button>
                <button type="button" class="admin-secondary-btn" id="adminTextReviewLearnedListBtn">
                  Show list learned blocked word(s)
                </button>
                <button type="button" class="admin-secondary-btn" id="adminTextReviewPresetRiskListBtn">
                  Show list with risk words
                </button>
                <p class="admin-text-review-learn-hint" id="adminTextReviewLearnHint" hidden>
                  Learn mode ON — on REJECT you can teach blocked words for future scans.
                </p>
                <p class="admin-text-review-learn-hint" id="adminTextReviewLearnedTermsMeta"></p>
              </div>

              <div class="admin-text-review-frame" id="adminTextReviewFrame">
                <p class="admin-empty" id="adminTextReviewEmpty">Loading queue...</p>
                <div id="adminTextReviewContent" hidden>
                  <p class="admin-text-review-type" id="adminTextReviewType"></p>
                  <h3 class="admin-text-review-title" id="adminTextReviewTitle" hidden></h3>
                  <p class="admin-text-review-text" id="adminTextReviewText"></p>
                  <p class="admin-text-review-risk-reason" id="adminTextReviewRiskReason" hidden></p>
                  <div class="admin-text-review-meta" id="adminTextReviewMeta"></div>
                </div>
              </div>

              <div class="admin-text-review-actions" id="adminTextReviewActions" hidden>
                <button type="button" class="admin-success-btn" id="adminTextReviewApproveBtn">APPROVE</button>
                <button type="button" class="admin-danger-btn" id="adminTextReviewRejectBtn">REJECT</button>
              </div>

              <p class="admin-text-review-counter" id="adminTextReviewCounter"></p>
            </div>
          </div>

          <div class="admin-posts-panel" id="adminPostsMediaReviewPanel" data-posts-panel="media-review" role="tabpanel" hidden>
            <div class="admin-media-review">
              <div class="admin-media-review-frame" id="adminMediaReviewFrame">
                <p class="admin-empty" id="adminMediaReviewEmpty">Loading queue...</p>
                <img id="adminMediaReviewImage" alt="" hidden>
              </div>

              <div class="admin-media-review-actions" id="adminMediaReviewActions" hidden>
                <button type="button" class="admin-success-btn" id="adminMediaReviewApproveBtn">APPROVE</button>
                <button type="button" class="admin-danger-btn" id="adminMediaReviewRejectBtn">REJECT</button>
              </div>

              <p class="admin-media-review-counter" id="adminMediaReviewCounter"></p>
            </div>
          </div>
        </div>
      </section>

      <section class="admin-section" id="adminSection-blog" data-section="blog" hidden>
        <p class="admin-section-lead">Create, edit, and delete public blog guides shown on <strong>/blog</strong>. Changes go live immediately after save.</p>

        <div id="adminBlogListView">
          <div class="admin-market-ads-toolbar">
            <p class="admin-results-meta" id="adminBlogMeta">Manage SiteCrew blog articles.</p>
            <button type="button" class="admin-primary-btn" id="adminBlogCreateBtn">
              <i class="bi bi-plus-lg"></i> Create article
            </button>
          </div>
          <div class="admin-table-wrap" id="adminBlogTable">
            <p class="admin-empty">Loading blog posts...</p>
          </div>
        </div>

        <div id="adminBlogEditorView" hidden>
          <div class="admin-market-ads-editor-header">
            <button type="button" class="admin-secondary-btn" id="adminBlogBackBtn">
              <i class="bi bi-arrow-left"></i> Back to articles
            </button>
            <p class="admin-results-meta" id="adminBlogEditorMeta">Create article</p>
          </div>

          <form id="adminBlogForm" class="admin-market-ad-form admin-blog-form">
            <fieldset class="admin-market-ad-section">
              <legend>Article details</legend>
              <label class="admin-field">
                <span>Title</span>
                <input type="text" id="adminBlogTitle" maxlength="200" placeholder="How to find construction jobs in the UK" required>
              </label>
              <div class="admin-market-ad-grid-2">
                <label class="admin-field">
                  <span>Slug (URL)</span>
                  <input type="text" id="adminBlogSlug" maxlength="120" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="find-construction-jobs-uk" required>
                </label>
                <label class="admin-field">
                  <span>&nbsp;</span>
                  <button type="button" class="admin-secondary-btn" id="adminBlogSlugFromTitleBtn">Generate slug from title</button>
                </label>
              </div>
              <label class="admin-field">
                <span>Description (meta + intro)</span>
                <textarea id="adminBlogDescription" rows="3" maxlength="500" placeholder="Short summary for SEO and the article header." required></textarea>
              </label>
              <div class="admin-market-ad-grid-2">
                <label class="admin-field">
                  <span>Category</span>
                  <input type="text" id="adminBlogCategory" maxlength="60" list="adminBlogCategoryOptions" placeholder="Careers" required>
                  <datalist id="adminBlogCategoryOptions">
                    <option value="Careers"></option>
                    <option value="Pay & rates"></option>
                    <option value="Guides"></option>
                    <option value="Hiring"></option>
                    <option value="Compliance"></option>
                  </datalist>
                </label>
                <label class="admin-field">
                  <span>Icon (Bootstrap Icons class)</span>
                  <select id="adminBlogIcon" required>
                    <option value="bi-journal-text">Journal</option>
                    <option value="bi-briefcase">Briefcase</option>
                    <option value="bi-cash-stack">Cash stack</option>
                    <option value="bi-tools">Tools</option>
                    <option value="bi-building">Building</option>
                    <option value="bi-geo-alt">Location</option>
                    <option value="bi-people">People</option>
                  </select>
                </label>
              </div>
              <label class="admin-field">
                <span>Published date</span>
                <input type="date" id="adminBlogPublishedAt" required>
              </label>
            </fieldset>

            <fieldset class="admin-market-ad-section">
              <legend>Social share image</legend>
              <p class="admin-section-lead">Choose the image shown when this article is shared on Facebook, LinkedIn, X, etc. Recommended size: 1200×630.</p>
              <input type="hidden" id="adminBlogOgImage" value="">
              <div class="admin-og-presets" id="adminBlogOgPresets">
                <p class="admin-empty">Loading image options...</p>
              </div>
              <div class="admin-market-ad-grid-2">
                <label class="admin-field">
                  <span>Upload custom image</span>
                  <input type="file" id="adminBlogOgImageFile" accept="image/jpeg,image/png,image/webp,image/gif">
                </label>
                <label class="admin-field">
                  <span>Or image path</span>
                  <input type="text" id="adminBlogOgImagePath" maxlength="500" placeholder="/images/og/presets/site-default.png">
                </label>
              </div>
              <label class="admin-field">
                <span>Image alt text (optional)</span>
                <input type="text" id="adminBlogOgImageAlt" maxlength="200" placeholder="Short description for accessibility and social previews">
              </label>
              <div class="admin-og-preview" id="adminBlogOgPreview" hidden>
                <span>Preview</span>
                <img id="adminBlogOgPreviewImg" alt="">
              </div>
            </fieldset>

            <fieldset class="admin-market-ad-section">
              <div class="admin-market-ad-section-head">
                <legend>Content sections</legend>
                <button type="button" class="admin-secondary-btn" id="adminBlogAddSectionBtn">Add section</button>
              </div>
              <div id="adminBlogSectionsList" class="admin-blog-sections-list"></div>
            </fieldset>

            <div class="admin-market-ad-form-actions">
              <a href="#" id="adminBlogPreviewLink" class="admin-secondary-btn" target="_blank" rel="noopener noreferrer" hidden>Preview live</a>
              <button type="button" class="admin-danger-btn" id="adminBlogDeleteBtn" hidden>Delete article</button>
              <button type="submit" class="admin-primary-btn" id="adminBlogSaveBtn">Save article</button>
            </div>
          </form>
        </div>
