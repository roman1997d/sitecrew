<section class="company-section company-market-section" id="market-statistic">
  <div class="company-section-header">
    <div>
      <span>Market statistic</span>
      <h2>Live SiteCrew hiring demand</h2>
    </div>
    <p data-market-updated>Real platform signals from job search, applications, and open roles. Snapshot updates daily.</p>
  </div>

  <div class="company-market-loading" data-market-loading>
    <div class="company-market-loading-bar"></div>
    <p>Loading market signals from SiteCrew…</p>
  </div>

  <div class="company-market-error" data-market-error hidden></div>

  <div class="company-market-content" data-market-content hidden>
    <div class="company-market-summary" data-market-summary hidden></div>

    <div class="company-market-grid">
      <article class="company-market-card">
        <header>
          <span>Most searched jobs</span>
          <h3>What workers type into SiteCrew search</h3>
        </header>
        <div class="company-market-bars" data-market-searched-jobs></div>
      </article>

      <article class="company-market-card">
        <header>
          <span>Hot trades</span>
          <h3>Trades searched &amp; applied for most</h3>
        </header>
        <div class="company-market-bars" data-market-trades></div>
      </article>

      <article class="company-market-card">
        <header>
          <span>Search cities</span>
          <h3>Where people look for work</h3>
        </header>
        <div class="company-market-bars" data-market-cities></div>
      </article>

      <article class="company-market-card">
        <header>
          <span>Rates that attract</span>
          <h3>Pay bands getting the most applications</h3>
        </header>
        <div class="company-market-bars" data-market-rates></div>
      </article>

      <article class="company-market-card company-market-card-wide">
        <header>
          <span>Demand vs open jobs</span>
          <h3>Worker interest compared with live vacancies</h3>
        </header>
        <div class="company-market-compare" data-market-compare></div>
      </article>

      <article class="company-market-card">
        <header>
          <span>Worker supply</span>
          <h3>Trades most common among active workers</h3>
        </header>
        <div class="company-market-chips" data-market-worker-trades></div>
      </article>

      <article class="company-market-card">
        <header>
          <span>Worker cities</span>
          <h3>Cities most common among active workers</h3>
        </header>
        <div class="company-market-chips" data-market-worker-cities></div>
      </article>
    </div>
  </div>
</section>
