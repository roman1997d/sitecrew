<article
  class="company-team-card"
  data-team-worker-card
  data-worker-id="<%= worker.id %>"
  data-application-id="<%= worker.applicationId || '' %>"
  data-worker-name="<%= worker.name %>"
  data-occupation="<%= worker.occupation || '' %>"
  data-is-hired="<%= worker.isHired === false ? 'false' : 'true' %>"
  data-can-post-jobs="<%= worker.canPostJobs ? 'true' : 'false' %>"
  data-can-post-company-posts="<%= worker.canPostCompanyPosts ? 'true' : 'false' %>"
>
  <div class="company-card-row">
    <button type="button" class="company-worker-avatar company-worker-profile-trigger <%= worker.profilePhoto ? 'has-photo' : '' %>" data-team-worker-profile>
      <% if (worker.profilePhoto) { %>
        <img src="<%= assetPath(worker.profilePhoto) %>" alt="<%= worker.name %> profile picture">
      <% } else { %>
        <%= worker.initial %>
      <% } %>
    </button>
    <span class="company-status <%= roleLabel === 'Leader' ? 'review' : (roleLabel === 'Roster' ? 'closed' : 'open') %>" data-team-role-label><%= roleLabel %></span>
  </div>
  <h3><button type="button" class="company-team-name-btn" data-team-worker-profile><%= worker.name %></button></h3>
  <p data-team-occupation-label>
    <% if (worker.occupation) { %>
      <i class="bi bi-person-badge"></i> Works as <strong><%= worker.occupation %></strong>
    <% } else { %>
      <i class="bi bi-person-badge"></i> Occupation not set
    <% } %>
  </p>
  <small><i class="bi bi-tools"></i> <%= worker.trade %></small>
  <% if (worker.isHired !== false) { %>
    <small><i class="bi bi-briefcase"></i> Working on <%= worker.jobTitle %></small>
  <% } else if (worker.occupation) { %>
    <small><i class="bi bi-briefcase"></i> Roster · <%= worker.occupation %></small>
  <% } else { %>
    <small><i class="bi bi-briefcase"></i> Added to company roster</small>
  <% } %>
  <small><i class="bi bi-geo-alt"></i> <%= worker.city %> · <%= worker.experience %></small>
  <small><i class="bi bi-patch-check"></i> <%= worker.certificates %></small>
  <% if (!worker.isLeader) { %>
    <button type="button" class="company-team-move-leader-btn" data-move-to-leaders>
      Move to Leaders
    </button>
  <% } else { %>
    <button type="button" class="company-team-move-operative-btn" data-move-to-operatives>
      Move to Operatives
    </button>
  <% } %>
</article>
