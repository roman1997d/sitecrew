<%
  const portfolioTypeLabels = {
    work_completed: 'Past work',
    certification: 'Course / qualification',
    skills: 'Skills offered',
    progress: 'Current project',
    company_update: 'Company update',
  };
%>
<section class="company-section" id="social-posts">
  <div class="company-section-header">
    <div>
      <span>Portfolio</span>
      <h2>Showcase your company’s work and expertise</h2>
    </div>
    <div class="company-feed-actions">
      <button type="button" class="company-link-btn as-button" data-open-company-post>Add portfolio item</button>
      <button type="button" class="company-link-btn as-button" data-open-company-story>Add Story</button>
    </div>
  </div>

  <p class="company-portfolio-page-copy">
    Post completed projects, courses you offer, and new qualifications. This builds trust with workers and shows clients what your company can deliver.
  </p>

  <div class="company-feed-list">
    <% if (!posts.length) { %>
      <article class="company-empty-card company-empty-card-cta">
        <div class="company-empty-icon" aria-hidden="true"><i class="bi bi-images"></i></div>
        <strong>No portfolio items yet</strong>
        <p>Add past work, a course, or a qualification to start your company portfolio.</p>
        <button type="button" class="company-empty-cta" data-open-company-post>
          <i class="bi bi-plus-lg"></i> Add portfolio item
        </button>
      </article>
    <% } %>

    <% posts.forEach(function(post) { %>
      <article
        class="company-feed-card"
        data-company-feed-post
        data-post-id="<%= post.id %>"
        data-title="<%= post.title %>"
        data-caption="<%= post.caption %>"
        data-location="<%= post.location %>"
        data-tags="<%= post.tags.join(', ') %>"
        data-post-type="<%= post.postType || 'work_completed' %>"
        data-project-size="<%= post.projectSize || '' %>"
      >
        <% const companyMediaItems = Array.isArray(post.mediaItems) && post.mediaItems.length
          ? post.mediaItems
          : (post.mediaUrl ? [{ url: post.mediaSrc || post.mediaUrl, type: post.mediaType || 'image' }] : []); %>
        <div class="company-feed-media <%= post.mediaClass %> <%= companyMediaItems.length ? 'has-real-media' : '' %><%= companyMediaItems.length > 1 ? ' has-multi' : '' %>">
          <% if (companyMediaItems.length === 1) { %>
            <% if (companyMediaItems[0].type === 'video') { %>
              <video src="<%= assetPath(companyMediaItems[0].url) %>" controls playsinline></video>
            <% } else { %>
              <img src="<%= assetPath(companyMediaItems[0].url) %>" alt="<%= post.title %>">
            <% } %>
          <% } else if (companyMediaItems.length > 1) { %>
            <div class="company-feed-media-grid">
              <% companyMediaItems.forEach(function(media, mediaIndex) { %>
                <% if (media.type === 'video') { %>
                  <video src="<%= assetPath(media.url) %>" controls playsinline></video>
                <% } else { %>
                  <img src="<%= assetPath(media.url) %>" alt="<%= post.title %> photo <%= mediaIndex + 1 %>">
                <% } %>
              <% }); %>
            </div>
          <% } %>
        </div>
        <div>
          <div class="company-feed-meta-row">
            <span class="company-portfolio-type-badge type-<%= post.postType || 'work_completed' %>">
              <%= portfolioTypeLabels[post.postType] || portfolioTypeLabels.work_completed %>
            </span>
            <span><%= post.location %> · <%= post.time %></span>
          </div>
          <h3><%= post.title %></h3>
          <% if (post.projectSize) { %>
            <small class="company-feed-project-size"><%= post.projectSize %></small>
          <% } %>
          <p><%= post.caption %></p>
          <% if (post.tags && post.tags.length) { %>
            <div class="company-feed-tags">
              <% post.tags.forEach(function(tag) { %>
                <span>#<%= tag %></span>
              <% }); %>
            </div>
          <% } %>
          <div class="company-post-stats" aria-label="Post engagement">
            <button type="button" class="company-post-stat" data-open-post-engagement="views" data-post-id="<%= post.id %>" data-post-title="<%= post.title %>">
              <i class="bi bi-eye" aria-hidden="true"></i>
              <strong><%= (post.stats && post.stats.views) || 0 %></strong>
              <span>Views</span>
            </button>
            <button type="button" class="company-post-stat" data-open-post-engagement="likes" data-post-id="<%= post.id %>" data-post-title="<%= post.title %>">
              <i class="bi bi-heart" aria-hidden="true"></i>
              <strong><%= (post.stats && post.stats.likes) || 0 %></strong>
              <span>Likes</span>
            </button>
            <button type="button" class="company-post-stat" data-open-post-engagement="comments" data-post-id="<%= post.id %>" data-post-title="<%= post.title %>">
              <i class="bi bi-chat" aria-hidden="true"></i>
              <strong><%= (post.stats && post.stats.comments) || 0 %></strong>
              <span>Comments</span>
            </button>
            <button type="button" class="company-post-stat" data-open-post-engagement="saves" data-post-id="<%= post.id %>" data-post-title="<%= post.title %>">
              <i class="bi bi-bookmark" aria-hidden="true"></i>
              <strong><%= (post.stats && post.stats.saves) || 0 %></strong>
              <span>Saved</span>
            </button>
            <button type="button" class="company-post-stat" data-open-post-engagement="likes" data-post-id="<%= post.id %>" data-post-title="<%= post.title %>">
              <i class="bi bi-emoji-smile" aria-hidden="true"></i>
              <strong><%= (post.stats && post.stats.reactions) || 0 %></strong>
              <span>Reactions</span>
            </button>
          </div>
          <div class="company-feed-post-actions">
            <button type="button" data-edit-company-post>Edit</button>
            <button type="button" class="danger" data-delete-company-post>Delete</button>
          </div>
        </div>
      </article>
    <% }); %>
  </div>
</section>
