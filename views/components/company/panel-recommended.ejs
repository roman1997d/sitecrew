<section class="company-panel" id="recommended-workers-side">
  <div class="company-panel-head">
    <h2>Recommended Workers</h2>
    <a href="#search-workers" class="company-panel-link" data-company-goto="search-workers">View all</a>
  </div>
  <% if (!workers.length) { %>
    <div class="company-empty-inline company-empty-inline-cta">
      <strong>No matches yet</strong>
      <span>Open a job and we’ll recommend workers by trade and location.</span>
      <button type="button" class="company-empty-link-cta" data-open-post-job>Post a job</button>
    </div>
  <% } %>
  <div class="company-panel-list">
    <% workers.slice(0, 3).forEach(function(worker) { %>
      <article class="company-reco-item" data-worker-id="<%= worker.id %>">
        <button
          type="button"
          class="company-reco-avatar"
          data-view-recommended-worker-profile
          data-worker-id="<%= worker.id %>"
          aria-label="View <%= worker.name %> profile"
        ><%= worker.name.charAt(0) %></button>
        <div class="company-reco-copy">
          <button
            type="button"
            class="company-reco-name"
            data-view-recommended-worker-profile
            data-worker-id="<%= worker.id %>"
          ><%= worker.name %></button>
          <span><%= worker.trade %> · <%= worker.location %></span>
          <small><i class="bi bi-circle-fill"></i> <%= worker.availability %></small>
          <div class="company-reco-actions">
            <button
              type="button"
              class="company-reco-action"
              data-view-recommended-worker-profile
              data-worker-id="<%= worker.id %>"
            ><i class="bi bi-person-badge"></i> Profile</button>
            <button
              type="button"
              class="company-reco-action primary"
              data-send-worker-message
              data-worker-id="<%= worker.id %>"
              data-worker-name="<%= worker.name %>"
            ><i class="bi bi-chat-dots"></i> Message</button>
          </div>
        </div>
        <span class="company-reco-match"><%= worker.score %>% Match</span>
      </article>
    <% }); %>
  </div>
</section>
