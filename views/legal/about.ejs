<%- include('../partials/header', { seo: seo }) %>

<section class="section">
  <div class="site-container">
    <div class="section-header">
      <span class="section-eyebrow">About SiteCrew</span>
      <h1 class="section-title">UK construction hiring, without the agency layer</h1>
      <p class="section-desc">SiteCrew connects skilled tradespeople with verified construction companies for direct hiring, job applications, and site communication.</p>
    </div>

    <div class="about-grid">
      <article class="about-card">
        <h2>What we do</h2>
        <p>SiteCrew is a recruitment platform built for the UK construction industry. Workers find open site roles, set trade interests, and apply directly. Companies post jobs, review applicants, and message workers without middlemen.</p>
      </article>
      <article class="about-card">
        <h2>Who we serve</h2>
        <p>Electricians, builders, dryliners, plasterers, labourers, carpenters, plumbers, and companies hiring across residential, commercial, and fit-out projects nationwide.</p>
      </article>
      <article class="about-card">
        <h2>Why SiteCrew</h2>
        <ul class="about-list">
          <li>Verified companies reviewed by our admin team</li>
          <li>Real worker profiles with trade interests and availability</li>
          <li>Direct messaging between companies and applicants</li>
          <li>Transparent job listings with rates and locations</li>
        </ul>
      </article>
    </div>

    <div class="public-jobs-cta">
      <p>Ready to get started?</p>
      <div class="hero-cta">
        <a href="/login?mode=register&role=worker" class="btn-sc btn-sc-cta">Join as worker</a>
        <a href="/login?mode=register&role=company" class="btn-sc btn-sc-outline">Join as company</a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
