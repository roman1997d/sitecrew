<%- include('../partials/header', { seo: seo }) %>

<section class="section blog-post-page">
  <div class="site-container">
    <a href="/blog" class="public-job-back"><i class="bi bi-arrow-left"></i> Back to blog</a>

    <article class="blog-post">
      <span class="blog-date"><%= new Date(post.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
      <h1 class="section-title"><%= post.title %></h1>
      <p class="section-desc"><%= post.description %></p>

      <% post.sections.forEach(function(section) { %>
        <section class="blog-section">
          <h2><%= section.heading %></h2>
          <% section.paragraphs.forEach(function(paragraph) { %>
            <p><%= paragraph %></p>
          <% }); %>
        </section>
      <% }); %>

      <div class="blog-post-cta">
        <a href="/jobs" class="btn-sc btn-sc-cta">Browse construction jobs</a>
        <a href="/login?mode=register&role=worker" class="btn-sc btn-sc-outline">Join as worker</a>
      </div>
    </article>
  </div>
</section>

<%- include('../partials/footer') %>
